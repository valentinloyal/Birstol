{
  "name": "bristol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bristol — fiches de révision, PWA hors-ligne sans serveur ni compte.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --loader:.jsx=jsx --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=app.js",
    "test": "node --test",
    "build:cloud": "esbuild src/main-cloud.jsx --bundle --minify --format=iife --loader:.jsx=jsx --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --define:process.env.NEON_AUTH_URL=\\\"https://ep-green-truth-auc75uno.neonauth.c-10.us-east-1.aws.neon.tech/neondb/auth\\\" --define:process.env.NEON_DATA_API_URL=\\\"https://ep-green-truth-auc75uno.apirest.c-10.us-east-1.aws.neon.tech/neondb/rest/v1\\\" --outfile=cloud/app.js"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^0.7.0-beta",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
